/**
 * @file FUVLumToMassDataLocation.hpp
 *
 * @brief CMake configured file storing the location of the FUVLumToMass data from Starburst99 Kroupa IMF model, Mass range = 0.1-100 Msun, Metallicity = MW (0.014)
 *
 * This file should never be edited directly. Instead, edit
 * FUVLumToMassDataLocation.hpp.in.
 *
 * @author Bert Vandenbroucke (bv7@st-andrews.ac.uk)
 */
#ifndef FUVLUMTOMASSDATALOCATION_HPP
#define FUVLUMTOMASSDATALOCATION_HPP

#define FUVLUMTOMASSDATALOCATION "@FUVLUMTOMASSDATALOCATION@"

#endif // FUVLUMTOMASSDATALOCATION_HPP
